# --- platform (workstream F): secrets, backups, evidence, deploy state ---
# Real environment files. Only the *.example files are committed.
.env
.env.*
!.env.example
!**/.env.example
deploy/*/.env
deploy/*/.env.*
!deploy/*/.env.example
deploy/*/backup.conf
# Keys and certificates
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
age-identity*.txt
# Database dumps and encrypted backups
*.dump
*.dump.age
*.sql.gz
# Evidence bundles are collected locally and kept outside git (see compliance/README.md)
compliance/evidence/out/
# Dependencies
node_modules/
