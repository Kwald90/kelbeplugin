{
  "name": "fishtape-server",
  "version": "0.1.0",
  "private": true,
  "description": "Fishtape API and worker: Fastify + PostgreSQL with row-level security.",
  "type": "module",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "start": "node src/index.js",
    "worker": "node src/worker.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "tenant:create": "node src/cli/create-tenant.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:embedded": "node scripts/with-embedded-pg.js",
    "lint": "node scripts/lint.js",
    "gen:collections-sql": "node scripts/gen-collections-sql.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@fastify/cookie": "11.1.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.1",
    "@node-rs/argon2": "2.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.5",
    "openid-client": "6.8.8",
    "otplib": "13.5.0",
    "pg": "8.23.1",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "embedded-postgres": "17.9.0-beta.16"
  },
  "overrides": {
    "light-my-request": "6.6.0"
  },
  "overridesNote": "cookie 2.x is ESM-only and needs Node >= 22.12 (require(esm)); these pins keep Node 22.11 working. Drop them once every machine runs >= 22.12."
}
