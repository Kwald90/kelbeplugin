# Fishtape API configuration. Copy to server/.env (git-ignored, chmod 600, never under
# the web root) or set real environment variables; real environment values win.
# Placeholders only: never commit real values.

# local | test | staging | production
APP_ENV=local
PORT=3410
# Listen address. Behind nginx on the same host keep 127.0.0.1.
HOST=127.0.0.1

# Postgres roles (see server/db/bootstrap.sql). The API and worker use fishtape_app.
DATABASE_URL=postgres://fishtape_app:change-me@127.0.0.1:5433/fishtape
# npm run migrate (and the local seed's signup flag) use the owner role.
MIGRATE_DATABASE_URL=postgres://fishtape_owner:change-me@127.0.0.1:5433/fishtape
# HQ endpoints that read across tenants use the BYPASSRLS role. Optional locally.
HQ_DATABASE_URL=postgres://fishtape_hq:change-me@127.0.0.1:5433/fishtape
DB_POOL_MAX=10

# Where the PWA is served (cookies, OIDC redirects, email links, CORS).
PUBLIC_ORIGIN=http://localhost:8080
# Extra allowed origins, comma separated. capacitor://localhost is always allowed.
CORS_ORIGINS=
# Proxies whose X-Forwarded-For is trusted (proxy-addr syntax).
TRUST_PROXY=loopback,uniquelocal
# Secure cookies default to on for https PUBLIC_ORIGIN; override with true/false.
COOKIE_SECURE=

# Envelope key for tenant secrets and MFA secrets: base64 of 32 random bytes.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in staging/production. Locally a fixed public dev key is used when empty.
SECRETS_MASTER_KEY=

# Google / Microsoft sign-in: each provider is on only when both values are set.
# Redirect URI to register: <PUBLIC_ORIGIN>/api/v1/auth/oidc/<google|microsoft>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Entra tenant: common (any work or personal account), organizations, or a tenant id.
MICROSOFT_TENANT=common

LOG_LEVEL=info
# Set by CI/deploy so /api/v1/status and HQ health show the running commit.
GIT_SHA=

# Sessions (seconds): web/bearer absolute and idle, crew (shared device) absolute and idle.
SESSION_TTL_S=2592000
SESSION_IDLE_S=604800
CREW_SESSION_TTL_S=43200
CREW_SESSION_IDLE_S=7200

# Lockouts.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
PIN_MAX_FAILURES=5
PIN_LOCK_MINUTES=15
DEVICE_PIN_MAX_FAILURES=20
MFA_MAX_FAILURES=5

# Rate limits per minute (in-memory, per process). RATE_LIMIT=off disables them.
RATE_LIMIT=on
RATE_LIMIT_GLOBAL=600
RATE_LIMIT_AUTH=10
RATE_LIMIT_API_KEY=300

# /api/readyz fails when the oldest due job has waited longer than this (0 = ignore).
READY_MAX_QUEUE_LAG_S=900
# Optional, shown in HQ health: JSON written by the backup script, and the TLS cert.
BACKUP_STATUS_FILE=
TLS_CERT_FILE=

WORKER_POLL_MS=2000
WORKER_CONCURRENCY=2

# Only when the API runs without the repo next to it (e.g. a slim container):
# SCHEMA_DIR=/app/electrical-app/js/schema/

# Tests: a superuser URL. Role passwords are optional (tests SET ROLE without them).
# TEST_DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5433/postgres
# TEST_OWNER_PASSWORD=
# TEST_APP_PASSWORD=
# TEST_HQ_PASSWORD=

# ---- Fishtape's own email (password resets, invites, HQ alerts, HQ Mail) -------------------
# Steps: docs/email/sendgrid-setup.md. Leave the key empty and system email waits in the queue
# (nothing is sent). Company email uses each company's own key from Integrations, not these.
# sendgrid | resend (default: sendgrid when SENDGRID_API_KEY is set)
EMAIL_PROVIDER=
# Restricted key with Mail Send only (starts with SG.).
SENDGRID_API_KEY=
# The older provider; only used with EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Sender of system email, on a domain authenticated in SendGrid: Fishtape <no-reply@fishtapehq.com>
EMAIL_FROM=
# Signed Event Webhook verification key (SendGrid shows it after "Enable Signed Event Webhook").
SENDGRID_EVENT_PUBLIC_KEY=
# Ask SendGrid to report opens (on|off). Click tracking is always off.
SENDGRID_TRACK_OPENS=off
# Inbound Parse: the secret last part of the URL .../webhooks/sendgrid/inbound/<token>
#   openssl rand -hex 32
SENDGRID_INBOUND_TOKEN=
# Optional: verification key of an Inbound Parse security policy (signed inbound posts).
SENDGRID_INBOUND_PUBLIC_KEY=
# Attachments and original messages. Outside the code checkout and the web root; in Docker
# this is the mounted volume (docker-compose.yml), owned by uid 1000, chmod 700.
MAIL_DIR=
# Domain used in Message-IDs and the support reply address (support@inbox.<MAIL_DOMAIN>).
MAIL_DOMAIN=fishtapehq.com

# ---- Billing: Fishtape's own Stripe account (subscriptions) -------------------------------
# Test-mode keys on staging. Run `node scripts/stripe-setup.js` once to create the prices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Days a company keeps its paid plan after a failed payment, and the free trial length.
BILLING_GRACE_DAYS=7
TRIAL_DAYS=14
# Self-serve sign-up (site/signup.html): 14-day trial + $1 deposit credited to the first invoice.
# Where the form lives (Stripe returns there); default PUBLIC_ORIGIN/site/signup.html.
SIGNUP_PAGE_URL=
# Minutes the Stripe Checkout page stays open (31-1439), and form attempts per IP / overall per hour.
SIGNUP_CHECKOUT_MINUTES=60
SIGNUP_RATE_LIMIT_PER_HOUR=10
SIGNUP_RATE_LIMIT_GLOBAL_PER_HOUR=100

# ---- HQ -------------------------------------------------------------------------------------
# Where Enterprise "Let's talk" alerts go.
HQ_NOTIFY_EMAIL=
# Where HQ lives, for links in emails (default PUBLIC_ORIGIN/hq/).
HQ_PUBLIC_URL=http://localhost:8080/hq/
# Other environments shown on the developer health page: name=url,name=url
HQ_ENVIRONMENTS=staging=https://tgelectrical.truecollarbuilt.com

# ---- Public status page (docs/runbooks/status-page.md) -------------------------------------
# The worker probes the app, API, HQ and sign-in every 5 minutes. off = no network probes; or
# replace some URLs: app=https://...,api=https://.../api/readyz,hq=https://.../api/healthz,signin=...
STATUS_PROBES=off
# The public status page, for links in status emails (default PUBLIC_ORIGIN/site/status.html).
STATUS_PUBLIC_URL=

# ---- AI (each company brings its own Anthropic key) ----------------------------------------
# Default monthly AI spend cap per company, in US cents.
AI_DEFAULT_MONTHLY_CAP_CENTS=5000

# ---- QuickBooks Online (docs/integrations/quickbooks.md, section 2.1) ---------------------------
# Fishtape's own Intuit app (platform credentials, never per company). Empty QBO_ENVIRONMENT turns
# QuickBooks off on this server. Set each value with deploy/set-env.sh; never paste them in a chat.
# sandbox | production (production keys only on a server whose hosting region matches what Fishtape
# told Intuit; checklist step 9)
QBO_ENVIRONMENT=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Verifier token of the app's webhook (<PUBLIC_ORIGIN>/api/v1/webhooks/qbo). While rotating, keep the old
# one in QBO_WEBHOOK_VERIFIER_PREVIOUS until Intuit shows only the new one, then empty it.
QBO_WEBHOOK_VERIFIER=
QBO_WEBHOOK_VERIFIER_PREVIOUS=
# off = platform kill switch: nothing is written to QuickBooks for any company; pulls continue and
# changes wait. For an incident across all companies (docs/runbooks/incident-response.md).
QBO_WRITES=on
# Monthly CorePlus read budgets, production only: the whole workspace (Intuit's free tier allows
# 500,000 for the app), each company, and each company on a free trial.
QBO_READ_BUDGET=450000
QBO_TENANT_READ_BUDGET=20000
QBO_TRIAL_READ_BUDGET=5000
# Worker slots for qbo_* jobs only (the general WORKER_CONCURRENCY slots never run them).
WORKER_QBO_CONCURRENCY=2
# Redirect URI to register in the Intuit app: <PUBLIC_ORIGIN>/api/v1/qbo/oauth/callback
# Tests and local only (ignored when APP_ENV is staging or production): the fake QuickBooks server.
# QBO_API_BASE=http://127.0.0.1:4010/v3/company
# QBO_OAUTH_BASE=http://127.0.0.1:4010
