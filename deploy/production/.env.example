# Fishtape production environment.
#
# Create the real file on the production host with:  sudo ./init-env.sh
# (fills every secret with fresh random values), then review the origins and provider keys.
# root:root, chmod 600, never committed, never copied from staging. Keep a copy of
# SECRETS_MASTER_KEY in the password manager. Rotation: docs/runbooks/rotate-secrets.md.
#
# Contract: docs/BUILD-PLAN.md, "Backend contract".

# ---- Postgres role passwords (hex: they go into connection URLs) ---------------------------
POSTGRES_SUPERUSER_PASSWORD=
FISHTAPE_OWNER_PASSWORD=
FISHTAPE_APP_PASSWORD=
FISHTAPE_HQ_PASSWORD=

# ---- Set by docker-compose.yml, listed so the contract is complete --------------------------
# APP_ENV=production
# PORT=3410
# HOST=0.0.0.0
# DATABASE_URL=postgres://fishtape_app:<FISHTAPE_APP_PASSWORD>@postgres:5432/fishtape
# MIGRATE_DATABASE_URL=postgres://fishtape_owner:<FISHTAPE_OWNER_PASSWORD>@postgres:5432/fishtape   (migrate only)
# HQ_DATABASE_URL=postgres://fishtape_hq:<FISHTAPE_HQ_PASSWORD>@postgres:5432/fishtape
# GIT_SHA=<baked into the image at build time from the release tag's commit>
# BACKUP_STATUS_FILE=/run/fishtape/status/last-backup.json

# ---- Origins ------------------------------------------------------------------------------
PUBLIC_ORIGIN=https://app.fishtapehq.com
# HQ console origin (informational; the API checks CORS_ORIGINS below).
HQ_ORIGIN=https://hq.fishtapehq.com
# Origins whose browsers may call the API (CORS and the CSRF Origin check): the app, the
# marketing site (its Enterprise form posts to /api/v1/public/), HQ (it signs in with a cookie
# from hq.) and the iOS app.
CORS_ORIGINS=https://app.fishtapehq.com,https://fishtapehq.com,https://hq.fishtapehq.com,capacitor://localhost

# ---- Tenant secrets envelope key (base64, 32 bytes; production-only value) ------------------
SECRETS_MASTER_KEY=

# ---- Sign-in providers -------------------------------------------------------------------
# Separate OAuth apps from staging. Redirect URI: https://app.fishtapehq.com/api/v1/auth/oidc/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---- Operations ---------------------------------------------------------------------------
LOG_LEVEL=info

# ---- Sizing for this host (read by docker-compose.yml) ---------------------------------------
# Defaults suit an 8 GB share of the box (staging and other sites run here too: 8 CPU / 31 GB in
# all). Rule of thumb: shared_buffers ~25% of the RAM you give Postgres.
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_MAX_CONNECTIONS=100
PG_CPUS=4
PG_MEM_LIMIT=4g
API_CPUS=2
API_MEM_LIMIT=1g
WORKER_CPUS=1
WORKER_MEM_LIMIT=512m

# ---- Fishtape's own email (password resets, invites, HQ alerts, HQ Mail) -------------------
# Steps: docs/email/sendgrid-setup.md. Leave the key empty and system email waits in the queue
# (nothing is sent). Company email uses each company's own key from Integrations, not these.
# sendgrid | resend (default: sendgrid when SENDGRID_API_KEY is set)
EMAIL_PROVIDER=
# Restricted key with Mail Send only (starts with SG.).
SENDGRID_API_KEY=
# The older provider; only used with EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Sender of system email, on a domain authenticated in SendGrid: Fishtape <no-reply@fishtapehq.com>
EMAIL_FROM=
# Signed Event Webhook verification key (SendGrid shows it after "Enable Signed Event Webhook").
SENDGRID_EVENT_PUBLIC_KEY=
# Ask SendGrid to report opens (on|off). Click tracking is always off.
SENDGRID_TRACK_OPENS=off
# Inbound Parse: the secret last part of the URL .../webhooks/sendgrid/inbound/<token>
#   openssl rand -hex 32
SENDGRID_INBOUND_TOKEN=
# Optional: verification key of an Inbound Parse security policy (signed inbound posts).
SENDGRID_INBOUND_PUBLIC_KEY=
# Attachments and original messages. Outside the code checkout and the web root; in Docker
# this is the mounted volume (docker-compose.yml), owned by uid 1000, chmod 700.
# Set by docker-compose.yml: MAIL_DIR=/var/lib/fishtape/mail
# Domain used in Message-IDs and the support reply address (support@inbox.<MAIL_DOMAIN>).
MAIL_DOMAIN=fishtapehq.com

# ---- Billing: Fishtape's own Stripe account (subscriptions) -------------------------------
# Test-mode keys on staging. Production: the live keys of Fishtape's own Stripe account, typed in
# on the server only (never in git). Then, once: docker compose exec api node scripts/stripe-setup.js --live
# Webhook endpoint: https://app.fishtapehq.com/api/v1/webhooks/platform-stripe (fishtapehq.com proxies it too).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Days a company keeps its paid plan after a failed payment, and the free trial length.
BILLING_GRACE_DAYS=7
TRIAL_DAYS=14
# Self-serve sign-up: 14-day trial + $1 deposit credited to the first invoice. Where the form
# lives (Stripe returns there), e.g. https://fishtapehq.com/signup; default PUBLIC_ORIGIN/site/signup.html.
SIGNUP_PAGE_URL=https://fishtapehq.com/signup
# Minutes the Stripe Checkout page stays open (31-1439), and form attempts per IP / overall per hour.
SIGNUP_CHECKOUT_MINUTES=60
SIGNUP_RATE_LIMIT_PER_HOUR=10
SIGNUP_RATE_LIMIT_GLOBAL_PER_HOUR=100

# ---- HQ -------------------------------------------------------------------------------------
# Where Enterprise "Let's talk" alerts go.
HQ_NOTIFY_EMAIL=
# Where HQ lives, for links in emails (default PUBLIC_ORIGIN/hq/).
HQ_PUBLIC_URL=https://hq.fishtapehq.com/
# Other environments shown on the developer health page: name=url,name=url
HQ_ENVIRONMENTS=staging=https://tgelectrical.truecollarbuilt.com

# ---- Public status page (docs/runbooks/status-page.md) -------------------------------------
# The worker probes the app, API, HQ and sign-in every 5 minutes. off = no network probes; or
# replace some URLs: app=https://...,api=https://.../api/readyz,hq=https://.../api/healthz,signin=...
STATUS_PROBES=
# The public status page, for links in status emails (default PUBLIC_ORIGIN/site/status.html).
STATUS_PUBLIC_URL=https://status.fishtapehq.com/

# ---- AI (each company brings its own Anthropic key) ----------------------------------------
# Default monthly AI spend cap per company, in US cents.
AI_DEFAULT_MONTHLY_CAP_CENTS=5000
