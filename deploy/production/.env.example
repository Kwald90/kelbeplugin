# Fishtape production environment.
#
# Create the real file on the production host with:  sudo ./init-env.sh
# (fills every secret with fresh random values), then review the origins and provider keys.
# root:root, chmod 600, never committed, never copied from staging. Keep a copy of
# SECRETS_MASTER_KEY in the password manager. Rotation: docs/runbooks/rotate-secrets.md.
#
# Contract: docs/BUILD-PLAN.md, "Backend contract".

# ---- Postgres role passwords (hex: they go into connection URLs) ---------------------------
POSTGRES_SUPERUSER_PASSWORD=
FISHTAPE_OWNER_PASSWORD=
FISHTAPE_APP_PASSWORD=
FISHTAPE_HQ_PASSWORD=

# ---- Set by docker-compose.yml, listed so the contract is complete --------------------------
# APP_ENV=production
# PORT=3410
# HOST=0.0.0.0
# DATABASE_URL=postgres://fishtape_app:<FISHTAPE_APP_PASSWORD>@postgres:5432/fishtape
# MIGRATE_DATABASE_URL=postgres://fishtape_owner:<FISHTAPE_OWNER_PASSWORD>@postgres:5432/fishtape   (migrate only)
# HQ_DATABASE_URL=postgres://fishtape_hq:<FISHTAPE_HQ_PASSWORD>@postgres:5432/fishtape
# GIT_SHA=<baked into the image at build time from the release tag's commit>
# BACKUP_STATUS_FILE=/run/fishtape/status/last-backup.json

# ---- Origins ------------------------------------------------------------------------------
PUBLIC_ORIGIN=https://app.fishtapehq.com
# HQ console origin (cookie and CSRF origin checks for /api/hq/*).
HQ_ORIGIN=https://hq.fishtapehq.com
CORS_ORIGINS=https://app.fishtapehq.com,https://hq.fishtapehq.com,capacitor://localhost

# ---- Tenant secrets envelope key (base64, 32 bytes; production-only value) ------------------
SECRETS_MASTER_KEY=

# ---- Sign-in providers -------------------------------------------------------------------
# Separate OAuth apps from staging. Redirect URI: https://app.fishtapehq.com/api/v1/auth/oidc/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---- Operations ---------------------------------------------------------------------------
LOG_LEVEL=info

# ---- Sizing for this host (read by docker-compose.yml) ---------------------------------------
# Defaults suit an 8 GB host. Rule of thumb: shared_buffers ~25% of the RAM you give Postgres.
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB
PG_MAX_CONNECTIONS=100
PG_CPUS=4
PG_MEM_LIMIT=4g
API_CPUS=2
API_MEM_LIMIT=1g
WORKER_CPUS=1
WORKER_MEM_LIMIT=512m
