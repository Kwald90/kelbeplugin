# Host profile for the dotmoose VPS (vps-bhs-1001.dotmoose.com), where Fishtape moved on 2026-11-25.
# Install as /etc/fishtape/production.env (root:root, 0644 or stricter). update.sh and
# install-nginx.sh read it; nothing secret goes here (secrets stay in .env).
#
# On this box Apache (httpd) owns :80/:443, terminates TLS with the app.fishtapehq.com certificate
# and proxies every Fishtape name to a Fishtape-only nginx container on 127.0.0.1:8443.

# The release checkout (root-owned, never under a web root).
REPO_DIR=/srv/fishtape/repo
# What the fishtape-nginx container mounts read-only at /srv/fishtape/www.
WWW_DIR=/home/fleet-staging/trees/srv/fishtape/www
# The certificate Apache serves (update.sh checks which names it covers before probing them).
CERT_FILE=/etc/letsencrypt/live/app.fishtapehq.com/fullchain.pem
# nginx runs in a container: install-nginx.sh renders the repo config for it and reloads it there.
NGINX_MODE=container
NGINX_CONTAINER=fishtape-nginx
NGINX_CONF_DIR=/home/fleet-staging/fishtape-nginx
