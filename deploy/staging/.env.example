# Fishtape staging environment.
#
# Create the real file with:  sudo ./init-env.sh      (fills every secret with random values)
# or copy this file to .env and fill it in by hand, then:  sudo chown root:root .env && sudo chmod 600 .env
# The real .env is never committed. Rotate per docs/runbooks/rotate-secrets.md.
#
# Contract: docs/BUILD-PLAN.md, "Backend contract". Staging and production never share a value.

# ---- Postgres role passwords --------------------------------------------------------------
# Hex only (openssl rand -hex 32): they are embedded in connection URLs. Used by the postgres
# container's first-start bootstrap (server/db/bootstrap.sql) and by docker-compose.yml to
# build the URLs below. Changing them later also needs ALTER ROLE (see rotate-secrets.md).
POSTGRES_SUPERUSER_PASSWORD=
FISHTAPE_OWNER_PASSWORD=
FISHTAPE_APP_PASSWORD=
FISHTAPE_HQ_PASSWORD=

# ---- Set by docker-compose.yml, listed here so the contract is complete ---------------------
# APP_ENV=staging
# PORT=3410
# HOST=0.0.0.0
# DATABASE_URL=postgres://fishtape_app:<FISHTAPE_APP_PASSWORD>@postgres:5432/fishtape
# MIGRATE_DATABASE_URL=postgres://fishtape_owner:<FISHTAPE_OWNER_PASSWORD>@postgres:5432/fishtape   (migrate/seed only)
# HQ_DATABASE_URL=postgres://fishtape_hq:<FISHTAPE_HQ_PASSWORD>@postgres:5432/fishtape
# GIT_SHA=<baked into the image at build time from the deployed commit>
# BACKUP_STATUS_FILE=/run/fishtape/status/last-backup.json
# RESTORE_TESTS_FILE=/var/lib/fishtape/drills/restore-tests.jsonl

# ---- Origins ------------------------------------------------------------------------------
PUBLIC_ORIGIN=https://tgelectrical.truecollarbuilt.com
# Comma-separated. The iOS app calls the API from capacitor://localhost.
CORS_ORIGINS=https://tgelectrical.truecollarbuilt.com,capacitor://localhost

# ---- Tenant secrets envelope key ------------------------------------------------------------
# base64 of 32 random bytes (openssl rand -base64 32). Encrypts the per-tenant data keys that
# protect tenant_secrets (Stripe, Twilio, Resend, Anthropic keys...). Losing it makes every
# stored tenant secret unreadable, so keep a copy in the password manager. Never reuse in production.
SECRETS_MASTER_KEY=

# ---- Sign-in providers (leave empty to hide the button) ------------------------------------
# Redirect URIs to register: https://tgelectrical.truecollarbuilt.com/api/v1/auth/oidc/<provider>/callback
# (confirm the exact path with the API's OpenAPI document).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---- Operations ---------------------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info

# ---- Fishtape's own email (password resets, invites, HQ alerts, HQ Mail) -------------------
# Steps: docs/email/sendgrid-setup.md. Leave the key empty and system email waits in the queue
# (nothing is sent). Company email uses each company's own key from Integrations, not these.
# sendgrid | resend (default: sendgrid when SENDGRID_API_KEY is set)
EMAIL_PROVIDER=
# Restricted key with Mail Send only (starts with SG.).
SENDGRID_API_KEY=
# The older provider; only used with EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Sender of system email, on a domain authenticated in SendGrid: Fishtape <no-reply@fishtapehq.com>
EMAIL_FROM=
# Signed Event Webhook verification key (SendGrid shows it after "Enable Signed Event Webhook").
SENDGRID_EVENT_PUBLIC_KEY=
# Ask SendGrid to report opens (on|off). Click tracking is always off.
SENDGRID_TRACK_OPENS=off
# Inbound Parse: the secret last part of the URL .../webhooks/sendgrid/inbound/<token>
#   openssl rand -hex 32
SENDGRID_INBOUND_TOKEN=
# Optional: verification key of an Inbound Parse security policy (signed inbound posts).
SENDGRID_INBOUND_PUBLIC_KEY=
# Attachments and original messages. Outside the code checkout and the web root; in Docker
# this is the mounted volume (docker-compose.yml), owned by uid 1000, chmod 700.
# Set by docker-compose.yml: MAIL_DIR=/var/lib/fishtape/mail
# Domain used in Message-IDs and the support reply address (support@inbox.<MAIL_DOMAIN>).
MAIL_DOMAIN=fishtapehq.com

# ---- Billing: Fishtape's own Stripe account (subscriptions) -------------------------------
# Test-mode keys on staging. Run `node scripts/stripe-setup.js` once to create the prices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Days a company keeps its paid plan after a failed payment, and the free trial length.
BILLING_GRACE_DAYS=7
TRIAL_DAYS=14
# Self-serve sign-up (site/signup.html): 14-day trial + $1 deposit credited to the first invoice.
# Where the form lives (Stripe returns there); default PUBLIC_ORIGIN/site/signup.html.
SIGNUP_PAGE_URL=
# Minutes the Stripe Checkout page stays open (31-1439), and form attempts per IP / overall per hour.
SIGNUP_CHECKOUT_MINUTES=60
SIGNUP_RATE_LIMIT_PER_HOUR=10
SIGNUP_RATE_LIMIT_GLOBAL_PER_HOUR=100

# ---- HQ -------------------------------------------------------------------------------------
# Where Enterprise "Let's talk" alerts go.
HQ_NOTIFY_EMAIL=
# Where HQ lives, for links in emails (default PUBLIC_ORIGIN/hq/).
HQ_PUBLIC_URL=https://tgelectrical.truecollarbuilt.com/hq/
# Other environments shown on the developer health page: name=url,name=url
HQ_ENVIRONMENTS=production=https://app.fishtapehq.com

# ---- Public status page (docs/runbooks/status-page.md) -------------------------------------
# The worker probes the app, API, HQ and sign-in every 5 minutes. off = no network probes; or
# replace some URLs: app=https://...,api=https://.../api/readyz,hq=https://.../api/healthz,signin=...
STATUS_PROBES=
# The public status page, for links in status emails (default PUBLIC_ORIGIN/site/status.html).
STATUS_PUBLIC_URL=

# ---- AI (each company brings its own Anthropic key) ----------------------------------------
# Default monthly AI spend cap per company, in US cents.
AI_DEFAULT_MONTHLY_CAP_CENTS=5000

# ---- QuickBooks Online (docs/integrations/quickbooks.md, section 2.1) ---------------------------
# Fishtape's own Intuit app (platform credentials, never per company). Empty QBO_ENVIRONMENT turns
# QuickBooks off on this server. Set each value with deploy/set-env.sh; never paste them in a chat.
# sandbox | production (production keys only on a server whose hosting region matches what Fishtape
# told Intuit; checklist step 9)
QBO_ENVIRONMENT=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Verifier token of the app's webhook (https://tgelectrical.truecollarbuilt.com/api/v1/webhooks/qbo). While rotating, keep the old
# one in QBO_WEBHOOK_VERIFIER_PREVIOUS until Intuit shows only the new one, then empty it.
QBO_WEBHOOK_VERIFIER=
QBO_WEBHOOK_VERIFIER_PREVIOUS=
# off = platform kill switch: nothing is written to QuickBooks for any company; pulls continue and
# changes wait. For an incident across all companies (docs/runbooks/incident-response.md).
QBO_WRITES=on
# Monthly CorePlus read budgets, production only: the whole workspace (Intuit's free tier allows
# 500,000 for the app), each company, and each company on a free trial.
QBO_READ_BUDGET=450000
QBO_TENANT_READ_BUDGET=20000
QBO_TRIAL_READ_BUDGET=5000
# Worker slots for qbo_* jobs only (the general WORKER_CONCURRENCY slots never run them).
WORKER_QBO_CONCURRENCY=2
# Redirect URI registered in the Intuit app: https://tgelectrical.truecollarbuilt.com/api/v1/qbo/oauth/callback
