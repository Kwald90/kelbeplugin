# Fishtape staging environment.
#
# Create the real file with:  sudo ./init-env.sh      (fills every secret with random values)
# or copy this file to .env and fill it in by hand, then:  sudo chown root:root .env && sudo chmod 600 .env
# The real .env is never committed. Rotate per docs/runbooks/rotate-secrets.md.
#
# Contract: docs/BUILD-PLAN.md, "Backend contract". Staging and production never share a value.

# ---- Postgres role passwords --------------------------------------------------------------
# Hex only (openssl rand -hex 32): they are embedded in connection URLs. Used by the postgres
# container's first-start bootstrap (server/db/bootstrap.sql) and by docker-compose.yml to
# build the URLs below. Changing them later also needs ALTER ROLE (see rotate-secrets.md).
POSTGRES_SUPERUSER_PASSWORD=
FISHTAPE_OWNER_PASSWORD=
FISHTAPE_APP_PASSWORD=
FISHTAPE_HQ_PASSWORD=

# ---- Set by docker-compose.yml, listed here so the contract is complete ---------------------
# APP_ENV=staging
# PORT=3410
# HOST=0.0.0.0
# DATABASE_URL=postgres://fishtape_app:<FISHTAPE_APP_PASSWORD>@postgres:5432/fishtape
# MIGRATE_DATABASE_URL=postgres://fishtape_owner:<FISHTAPE_OWNER_PASSWORD>@postgres:5432/fishtape   (migrate/seed only)
# HQ_DATABASE_URL=postgres://fishtape_hq:<FISHTAPE_HQ_PASSWORD>@postgres:5432/fishtape
# GIT_SHA=<baked into the image at build time from the deployed commit>
# BACKUP_STATUS_FILE=/run/fishtape/status/last-backup.json

# ---- Origins ------------------------------------------------------------------------------
PUBLIC_ORIGIN=https://tgelectrical.truecollarbuilt.com
# Comma-separated. The iOS app calls the API from capacitor://localhost.
CORS_ORIGINS=https://tgelectrical.truecollarbuilt.com,capacitor://localhost

# ---- Tenant secrets envelope key ------------------------------------------------------------
# base64 of 32 random bytes (openssl rand -base64 32). Encrypts the per-tenant data keys that
# protect tenant_secrets (Stripe, Twilio, Resend, Anthropic keys...). Losing it makes every
# stored tenant secret unreadable, so keep a copy in the password manager. Never reuse in production.
SECRETS_MASTER_KEY=

# ---- Sign-in providers (leave empty to hide the button) ------------------------------------
# Redirect URIs to register: https://tgelectrical.truecollarbuilt.com/api/v1/auth/oidc/<provider>/callback
# (confirm the exact path with the API's OpenAPI document).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---- Operations ---------------------------------------------------------------------------
# trace | debug | info | warn | error
LOG_LEVEL=info
