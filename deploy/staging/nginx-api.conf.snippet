# ---- Fishtape staging --------------------------------------------------------------------------
# Everything Fishtape needs inside the HTTPS server { } block of the CloudPanel vhost
#   /etc/nginx/sites-enabled/tgelectrical.truecollarbuilt.com.conf
#
# install-nginx.sh copies this file to /etc/nginx/snippets/fishtape-staging-site.conf, and the
# vhost includes it with one line (README.md, "Edit the vhost"). You can paste the contents
# instead, but then every change means editing the vhost again.
#
# Whichever you choose, remove the old Fishtape lines from the vhost (root, index, the sw.js /
# index.html / static-file locations, location /, the dot-file rule, old add_header lines).
# Keep CloudPanel's listen, server_name, ssl_* and ACME (/.well-known/acme-challenge/) lines.
# Needs /etc/nginx/snippets/fishtape-staging-headers.conf (install-nginx.sh copies it too).

root /var/www/tgelectrical/current/electrical-app;
index index.html;
server_tokens off;
charset utf-8;

# Every response gets the security headers (HSTS, CSP, Permissions-Policy, ...).
include /etc/nginx/snippets/fishtape-staging-headers.conf;

# Uploads ride on sync/REST (plan images are data: URLs inside drawing records).
client_max_body_size 25m;
client_body_timeout 30s;

# ---- API: 127.0.0.1:3410 (docker compose project fishtape-staging) ----
location ^~ /api/ {
    proxy_pass http://127.0.0.1:3410;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # nginx is the edge: overwrite, never append, so clients can't forge their address.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $request_id;
    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    # Never replay a request on another upstream: a retried POST could double-write.
    proxy_next_upstream off;
    # The API sets its own Cache-Control and CSP for anything it serves. This location has
    # add_header lines, so the server-level ones don't apply here; repeat the transport ones.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
}

# ---- HQ console (Phase 1), served from the checkout once hq/ exists ----
location ^~ /hq/ {
    root /var/www/tgelectrical/current;
    try_files $uri $uri/ /hq/index.html;
    expires epoch;
    # Optional on staging: only your own address.
    # allow 203.0.113.10;
    # deny all;
}

# ---- RFC 9116 security contact. Renew Expires every year (compliance calendar). ----
location = /.well-known/security.txt {
    default_type text/plain;
    return 200 "Contact: https://github.com/Kwald90/kelbeplugin/security/advisories/new\nExpires: 2027-10-19T00:00:00Z\nPolicy: https://github.com/Kwald90/kelbeplugin/security/policy\nPreferred-Languages: en, fr\nCanonical: https://tgelectrical.truecollarbuilt.com/.well-known/security.txt\n";
}

# ---- PWA ----
# Nothing hidden is served (.git, .env, ...), except ACME challenges. Regex locations match in
# file order, so this one comes before the static-file rules.
location ~ /\.(?!well-known/) {
    return 404;
}
# The service worker, HTML shell and manifest must always be revalidated so updates reach devices.
location = /sw.js {
    expires epoch;
    try_files $uri =404;
}
location = /index.html {
    expires epoch;
}
location = /manifest.webmanifest {
    default_type application/manifest+json;
    expires epoch;
}
# App code is not content-hashed (no build step), so it revalidates on every load (cheap 304s).
# A long cache here would pin old code on devices.
location ~* \.(?:js|mjs|css|json)$ {
    expires epoch;
    try_files $uri =404;
}
# Images, icons and fonts: long cache.
location ~* \.(?:png|jpe?g|gif|webp|avif|svg|ico|woff2?)$ {
    expires 30d;
    try_files $uri =404;
}
# Version-named third-party bundles (e.g. vendor/pdfjs-3.11.174/) never change.
location ^~ /vendor/ {
    expires 1y;
    try_files $uri =404;
}
location / {
    try_files $uri $uri/ /index.html;
    expires epoch;
}
# ---- end Fishtape staging ----------------------------------------------------------------------
