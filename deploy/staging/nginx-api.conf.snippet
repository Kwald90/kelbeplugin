# ---- Fishtape staging --------------------------------------------------------------------------
# Everything Fishtape needs inside the HTTPS server { } block of the CloudPanel vhost
#   /etc/nginx/sites-enabled/tgelectrical.truecollarbuilt.com.conf
#
# install-nginx.sh copies this file to /etc/nginx/snippets/fishtape-staging-site.conf, and the
# vhost includes it with one line (README.md, "Edit the vhost"). It also needs
# /etc/nginx/snippets/fishtape-staging-http.conf included once at the top of the vhost file,
# outside any server block (log format), plus fishtape-staging-headers.conf and
# fishtape-staging-proxy.conf (included below). install-nginx.sh copies all four.
#
# Remove the old Fishtape lines from the vhost (root, index, the sw.js / index.html / static-file
# locations, location /, the dot-file rule, old add_header lines). Keep CloudPanel's listen,
# server_name, ssl_* and ACME (/.well-known/acme-challenge/) lines.
#
# What is served: an allow-list. The web root is electrical-app/ only; secrets (.env) live in
# deploy/staging/, outside it. Only app file types are served, `/` serves index.html, and every
# other path is 404 (the app uses a hash router, so no SPA fallback is needed). Check after each
# deploy with deploy/check-exposure.sh.

# Kept to the minimum at server level, so nothing here duplicates a line CloudPanel already has
# (nginx -t fails on duplicate root / server_tokens / client_max_body_size). Body size and
# timeouts are set on /api/ only; static files are GET-only.
root /var/www/tgelectrical/current/electrical-app;
server_tokens off;
autoindex off;

# Every response gets the security headers (HSTS, CSP, Permissions-Policy, ...).
include /etc/nginx/snippets/fishtape-staging-headers.conf;

# ---- API (docker compose project fishtape-staging) ----
# Body size (72m), no-store, header clean-up and timeouts come from fishtape-staging-proxy.conf
# (= deploy/staging/nginx-proxy.conf). Logged without query strings or Referer queries (format
# in fishtape-staging-http.conf).
# Tenant API on 127.0.0.1:3410.
location ^~ /api/ {
    access_log /var/log/fishtape-staging/nginx-api.access.log fishtape_staging_noquery;
    limit_req zone=fishtape_staging_api burst=60 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:3410;
    include /etc/nginx/snippets/fishtape-staging-proxy.conf;
}
# Sign-in, MFA, PIN and reset routes: a much lower rate per address.
location ^~ /api/v1/auth/ {
    access_log /var/log/fishtape-staging/nginx-api.access.log fishtape_staging_noquery;
    limit_req zone=fishtape_staging_auth burst=20 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:3410;
    include /etc/nginx/snippets/fishtape-staging-proxy.conf;
}
# HQ endpoints go to hq-api on 127.0.0.1:3411, the only process with the BYPASSRLS role.
location ^~ /api/hq/ {
    access_log /var/log/fishtape-staging/nginx-api.access.log fishtape_staging_noquery;
    limit_req zone=fishtape_staging_api burst=60 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:3411;
    include /etc/nginx/snippets/fishtape-staging-proxy.conf;
}

# ---- HQ console (Phase 1), served from the checkout's hq/ folder once it exists ----
location ^~ /hq/ {
    root /var/www/tgelectrical/current;
    expires epoch;
    # Optional on staging: only your own address.
    # allow 203.0.113.10;
    # deny all;
    location ~ /\. { return 404; }
    location ~* \.(?:html|js|mjs|css|json|png|jpe?g|gif|webp|avif|svg|ico|woff2?)$ { try_files $uri =404; }
    location = /hq/ { try_files /hq/index.html =404; }
    return 404;
}

# ---- Public pages from the checkout's site/ folder (the marketing site) ----
# They use /css/tokens.css, /js/ and /icons/ from the app root, and call /api/ on this host.
# Staging serves every page as a file under /site/; the clean production URLs are not mapped here.
#   production (fishtapehq.com)        staging
#   /                                  /site/index.html
#   /pricing, /about, /services ...    /site/pricing.html, /site/about.html, /site/services.html ...
#   /features, /features/<slug>        /site/features/index.html, /site/features/<slug>.html
#   /for/<slug>                        /site/for/<slug>.html
#   /status (and status.fishtapehq.com) /site/status.html
#   /sitemap.xml, /robots.txt          /site/sitemap.xml, /site/robots.txt (for checking only)
# The HTML links to the clean URLs; site/site.js rewrites them to the /site/ files on any host
# that isn't a marketing host, so links work here too.
location ^~ /site/ {
    root /var/www/tgelectrical/current;
    expires epoch;
    location ~ /\. { return 404; }
    location = /site/sitemap.xml { default_type application/xml; try_files $uri =404; }
    location = /site/robots.txt { default_type text/plain; try_files $uri =404; }
    location ~* \.(?:html|js|mjs|css|png|jpe?g|gif|webp|avif|svg|ico|woff2?)$ { try_files $uri =404; }
    location = /site/ { return 302 /site/index.html; }
    return 404;
}

# ---- Uploaded landing-page media (HQ > Promotions; docs/marketing/landing.md) ----
# hq-api writes uploads to MEDIA_DIR under random names (32 hex + .mp4/.webm/.jpg/.png/.webp),
# after checking their bytes. On the host that is /var/lib/fishtape-staging/media, bind-mounted
# into the hq-api container (owned by the container's node user, 0755; files are 0644) and never
# inside the code checkout. nginx only reads it: those five file types, everything else 404,
# no listing, never executed (^~ stops any regex location, PHP included, from matching here).
# Names never change, so a year's cache is safe; byte ranges (video seeking) are nginx's default.
# Uploads arrive through /api/hq/ and so are capped by client_max_body_size in
# fishtape-staging-proxy.conf (72m); the API's own cap is MEDIA_MAX_VIDEO_MB (70 in compose).
location ^~ /media/ {
    root /var/lib/fishtape-staging;
    autoindex off;
    location ~ "^/media/[a-f0-9]{32}\.(?:mp4|webm|jpg|png|webp)$" {
        expires 1y;
        try_files $uri =404;
    }
    return 404;
}

# ---- RFC 9116 security contact. Renew Expires every year (compliance calendar). ----
location = /.well-known/security.txt {
    default_type text/plain;
    return 200 "Contact: https://github.com/Kwald90/kelbeplugin/security/advisories/new\nExpires: 2027-10-19T00:00:00Z\nPolicy: https://github.com/Kwald90/kelbeplugin/security/policy\nPreferred-Languages: en, fr\nCanonical: https://tgelectrical.truecollarbuilt.com/.well-known/security.txt\n";
}

# ---- Never served. Regex locations match in file order, so these come first. ----
# Dotfiles and dot-folders (.env, .git, .github ...), except /.well-known/.
location ~ /\.(?!well-known/) {
    return 404;
}
# Repo folders that must never be reachable, even if the root ever moves up a level.
location ~ ^/(?:deploy|server|docs|compliance|replica|includes|assets|tests|node_modules|mobile)(?:/|$) {
    return 404;
}
# Secrets, dumps, backups, keys, archives, scripts, docs and build files, by name.
location ~* (?:^|/)(?:[^/]*\.(?:env|sql|sh|bash|ps1|md|txt|bak|old|orig|save|swp|tmp|log|ya?ml|toml|ini|conf|cfg|pem|key|crt|csr|p12|pfx|jks|dump|age|sqlite3?|db|gz|tgz|bz2|xz|zip|tar|7z|rar|lock|map)|package(?:-lock)?\.json|Dockerfile|docker-compose[^/]*|Makefile)$ {
    return 404;
}

# ---- PWA: the allow-list ----
# `/`, the HTML shell, the service worker and the manifest are always revalidated so updates
# reach devices.
location = / {
    try_files /index.html =404;
    expires epoch;
}
location = /index.html {
    expires epoch;
}
location = /sw.js {
    expires epoch;
    try_files $uri =404;
}
location = /manifest.webmanifest {
    default_type application/manifest+json;
    expires epoch;
}
# App code is not content-hashed (no build step), so it revalidates on every load (cheap 304s).
# A long cache here would pin old code on devices. JSON = the shared schemas in js/schema/.
location ~* \.(?:js|mjs|css|json)$ {
    expires epoch;
    try_files $uri =404;
}
# Images, icons and fonts: long cache.
location ~* \.(?:png|jpe?g|gif|webp|avif|svg|ico|woff2?)$ {
    expires 30d;
    try_files $uri =404;
}
# Version-named third-party bundles (e.g. vendor/pdfjs-4.10.38/) never change.
location ^~ /vendor/ {
    location ~ /\. { return 404; }
    expires 1y;
    try_files $uri =404;
}
# Anything else: not part of the app.
location / {
    return 404;
}
# ---- end Fishtape staging ----------------------------------------------------------------------
