# Copy to deploy/local/.env (git-ignored) and set your own local values.
# These are for a Postgres on your own machine, bound to 127.0.0.1 only.
POSTGRES_PASSWORD=change-me-local-superuser
FISHTAPE_OWNER_PASSWORD=change-me-local-owner
FISHTAPE_APP_PASSWORD=change-me-local-app
FISHTAPE_HQ_PASSWORD=change-me-local-hq
