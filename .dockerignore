# Build context is the repo root (server/Dockerfile needs electrical-app/js/schema).
# Allow-list: ignore everything, then let in only what the server image needs.
*
!server/
!electrical-app/js/schema/

# Never send these into the build, even inside allowed folders.
**/node_modules
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.log
**/.DS_Store
server/test/
server/coverage/
server/.nyc_output/
