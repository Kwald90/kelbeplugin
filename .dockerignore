!electrical-app/js/lib/drawing-costs.js
!electrical-app/js/lib/drawing-collab.js
!electrical-app/js/canvas/symbols.js
!electrical-app/js/lib/modules.js
!electrical-app/js/lib/materials.js
!electrical-app/js/lib/location-policy.js
# Release 1 shared libraries (docs/releases/r1-get-paid.md 2.12); harmless until a file exists.
!electrical-app/js/lib/rules.js
!electrical-app/js/lib/closing.js
!electrical-app/js/lib/cost-codes.js
!electrical-app/js/lib/exemption.js
!electrical-app/js/lib/signing.js
!electrical-app/js/lib/timesheet.js
!electrical-app/js/lib/csv.js
!electrical-app/js/lib/tm.js
!electrical-app/js/lib/doc-view.js
!electrical-app/js/lib/receivables.js
!electrical-app/js/lib/prompt-payment.js
!electrical-app/js/lib/closeout.js
