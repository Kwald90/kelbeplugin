!compliance/controls.yaml

# Never send these into the build, even inside allowed folders.
**/node_modules
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.log
**/.DS_Store
server/test/
server/coverage/
server/.nyc_output/
