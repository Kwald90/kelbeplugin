# Files that run or are read on Linux servers keep LF endings on every checkout,
# including Windows (a CRLF shebang line breaks a shell script).
*.sh       text eol=lf
*.sql      text eol=lf
*.conf     text eol=lf
*.snippet  text eol=lf
*.service  text eol=lf
*.timer    text eol=lf
Dockerfile text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
